# FastAPI API path; Next.js proxies it to the backend origin below.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Server-side Next rewrite target. Set this to the deployed FastAPI origin in production.
AFTERCLASS_API_URL=http://localhost:8100

# Public Supabase credentials are used only for signed browser uploads.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public checkout key; private Razorpay credentials belong in backend/.env.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
