APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Supabase project URL + server-only secret API key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Protect writes to the clubs table. Use a long random local value.
ADMIN_API_TOKEN=replace_with_a_long_random_token

# Optional local-only endpoint for testing a Supabase write/read round-trip.
ENABLE_DB_DIAGNOSTICS=true
DIAGNOSTICS_API_TOKEN=replace_with_a_different_long_random_token

# Optional until payments are enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PUBLIC_KEY_ID=
