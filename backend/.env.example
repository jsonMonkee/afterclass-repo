APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Supabase project URL + server-only secret API key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Protect writes to the clubs table. Use a long random local value.
ADMIN_API_TOKEN=replace_with_a_long_random_token

# Optional local-only endpoint for testing a Supabase write/read round-trip.
ENABLE_DB_DIAGNOSTICS=false
DIAGNOSTICS_API_TOKEN=replace_with_a_different_long_random_token
AFTERCLASS_ENABLE_DEMO_ACCOUNTS=true

# Razorpay Checkout (Leave blank for automated dev test mode; add your test/live keys to enable real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PUBLIC_KEY_ID=

# Cloud Image Storage (Cloudinary free tier: 25GB free, or Supabase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=afterclass_uploads
SUPABASE_STORAGE_BUCKET=afterclass-images

# Custom SMTP / Direct Email (Optional: for sending OTP emails without Supabase free rate limits)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Afterclass Amity
